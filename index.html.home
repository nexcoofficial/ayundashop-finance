<!-- Formula Grid Cards -->
<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-space-md">
<!-- Formula 1 -->
<div class="bg-surface-card rounded-xl p-space-md shadow-sm space-y-space-sm flex flex-col justify-between">
<div>
<div class="font-label-caps text-label-caps text-accent-teal uppercase">Langkah 1</div>
<h4 class="font-title-md text-title-md text-ink-primary mt-1">COD Cair Masuk Rekening</h4>
<p class="font-body-sm text-body-sm text-ink-secondary mt-1">
              Total riil mutasi rekening bank dari pencairan ekspedisi (J&amp;T, Ninja, SiCepat, SAP).
            </p>
</div>
<div class="bg-surface-card-elevated rounded p-2 text-center font-num-table text-ink-primary text-xs">
            Net Mutasi = Gross Omzet − Ongkir Kurir − Fee Ekspedisi
          </div>
</div>
<!-- Formula 2 -->
<div class="bg-surface-card rounded-xl p-space-md shadow-sm space-y-space-sm flex flex-col justify-between">
<div>
<div class="font-label-caps text-label-caps text-kpi-burnt-orange uppercase">Langkah 2</div>
<h4 class="font-title-md text-title-md text-ink-primary mt-1">Alokasi Saver Buffer</h4>
<p class="font-body-sm text-body-sm text-ink-secondary mt-1">
              Penyisihan proteksi 10%–20% dari kas mingguan untuk cadangan likuiditas darurat.
            </p>
</div>
<div class="bg-surface-card-elevated rounded p-2 text-center font-num-table text-ink-primary text-xs">
            Saver Baru = Net Mutasi × Target Rasio Cadangan
          </div>
</div>
<!-- Formula 3 -->
<div class="bg-surface-card rounded-xl p-space-md shadow-sm space-y-space-sm flex flex-col justify-between">
<div>
<div class="font-label-caps text-label-caps text-accent-purple uppercase">Langkah 3</div>
<h4 class="font-title-md text-title-md text-ink-primary mt-1">Defisit RTS Absorpsi</h4>
<p class="font-body-sm text-body-sm text-ink-secondary mt-1">
              Kompensasi ongkos kirim hangus dan barang retur rusak diserap langsung oleh pool Saver.
            </p>
</div>
<div class="bg-surface-card-elevated rounded p-2 text-center font-num-table text-ink-primary text-xs">
            Net Saver = Saver Awal + Saver Baru − Total Defisit RTS
          </div>
</div>
<!-- Formula 4 -->
<div class="bg-surface-card rounded-xl p-space-md shadow-sm space-y-space-sm flex flex-col justify-between">
<div>
<div class="font-label-caps text-label-caps text-status-positive uppercase">Langkah 4</div>
<h4 class="font-title-md text-title-md text-ink-primary mt-1">Pembagian Deviden</h4>
