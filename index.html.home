<!-- Client-side Micro-Interaction Script -->
<script>
    document.addEventListener('DOMContentLoaded', () => {
      // Highlight current page active link in header if applicable
      const navLinks = document.querySelectorAll('header nav a');
      navLinks.forEach(link => {
        if (link.getAttribute('data-path') === 'overview' || link.textContent.trim() === 'Overview') {
          link.classList.add('bg-surface-card-elevated', 'text-ink-primary', 'font-semibold', 'shadow-sm');
          link.classList.remove('text-ink-secondary');
        }
      });
    });
  </script>
